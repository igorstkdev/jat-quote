{
  "name": "jat-quote",
  "version": "1.1.0",
  "private": true,
  "description": "JAT Quote — Cotação de Fretes (JAT Transportes e Logística)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @jat/api\" \"npm run dev -w @jat/web\"",
    "build": "npm run build -w @jat/core && npm run build -w @jat/api && npm run build -w @jat/web",
    "start": "npm run start -w @jat/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @jat/api",
    "db:generate": "npm run db:generate -w @jat/api",
    "test:core": "npm run test:coverage -w @jat/core",
    "db:seed": "npm run db:seed -w @jat/api --",
    "admin:recuperar-acesso": "npm run admin:recuperar-acesso -w @jat/api --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "argon2@0.45.2": true
  }
}
