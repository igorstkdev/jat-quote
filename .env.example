# JAT Quote — variáveis de ambiente
# Copie para ".env" (na raiz do projeto) e ajuste. O .env NUNCA vai para o git.

# Ambiente: development | test | production
NODE_ENV=development

# Endereço e porta da API. Em produção o mesmo servidor entrega o site.
# HOST=0.0.0.0 aceita conexões da rede local; use 127.0.0.1 para só a máquina local.
HOST=0.0.0.0
PORT=3333

# Nível de log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Senha do usuário "jat" do PostgreSQL (usada por scripts/setup-db.ps1 ao criar o usuário).
# Use só letras e números para não precisar escapar na URL.
DB_PASSWORD=troque-esta-senha

# Banco principal
DATABASE_URL=postgresql://jat:troque-esta-senha@localhost:5432/jat_quote

# Banco usado pelos testes de integração (é apagado/recriado pelos testes; nunca aponte para produção)
TEST_DATABASE_URL=postgresql://jat:troque-esta-senha@localhost:5432/jat_quote_test

# Sessão: horas sem uso até pedir login de novo
SESSION_TTL_HOURS=12

# Cookie só por HTTPS. Na rede local por http, deixe false.
COOKIE_SECURE=false

# true somente se houver um proxy reverso (IIS, nginx) na frente da API
TRUST_PROXY=false
